FROM ubuntu:22.04 AS build

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config \
    libleveldb-dev libssl-dev libyaml-cpp-dev libspdlog-dev \
    libhiredis-dev libraw-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY CMakeLists.txt ./
COPY include include
COPY src src
COPY third_party third_party
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF && \
    cmake --build build -j2 --target minikv_v2_gateway minikv_v2_datanode

FROM ubuntu:22.04 AS runtime
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl libleveldb1d libssl3 libyaml-cpp0.7 \
    libspdlog1 libhiredis0.14 libraw20 && \
    rm -rf /var/lib/apt/lists/*
COPY --from=build /src/build/bin/minikv_v2_gateway /usr/local/bin/
COPY --from=build /src/build/bin/minikv_v2_datanode /usr/local/bin/
RUN useradd --system --uid 10001 --create-home minikv && \
    mkdir -p /var/lib/minidriver && chown -R minikv:minikv /var/lib/minidriver
USER minikv
WORKDIR /var/lib/minidriver
