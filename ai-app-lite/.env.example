# Copy to ai-app-lite/.env for local overrides. Do not commit the real .env.

# PostgreSQL default is intentionally local-development only.
POSTGRES_PASSWORD=change-this-before-sharing

# If a host Redis already uses 6379, choose another port and point the host
# MiniDrive Gateway's MINIKV_V2_REDIS_PORT to the same value.
AI_REDIS_HOST_PORT=6379
# Default loopback is safe for a single host. For the three-host Tailscale
# deployment bind this to 100.89.50.125, never 0.0.0.0.
AI_REDIS_BIND_ADDRESS=127.0.0.1

# Browser-facing AI API bind/port. Use the same Tailscale-only bind address
# when the Gateway web UI and AI API live on different machines.
AI_API_BIND_ADDRESS=127.0.0.1
AI_API_HOST_PORT=18290

# AI containers reach the host-run MiniDrive Gateway through host-gateway.
AI_MINIDRIVE_GATEWAY_URL=http://host.docker.internal:8080
AI_CORS_ALLOW_ORIGIN=http://127.0.0.1:8080

# The minimal operations image uses the deterministic hash provider. Switch to
# a separate OpenCLIP-capable image only after its CPU/GPU dependencies are set.
AI_EMBEDDING_PROVIDER=hash
AI_EMBEDDING_DIM=256
